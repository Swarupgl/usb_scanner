[Unit]
Description=USB Sanitizer scan for %I
ConditionPathExists=/dev/%I
BindsTo=dev-%i.device
After=dev-%i.device
After=local-fs.target

[Service]
Type=simple
# Run as root to avoid permissions issues when udev triggers before desktop automount.
User=root
Group=root
WorkingDirectory=/home/pi/Ai
ExecStart=/home/pi/Ai/hardware/pi/usb-sanitize-run.sh /dev/%I
TimeoutStartSec=0
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
